# Server
PORT=8787
# Base URL embedded in TV QR / verification_uri (must be reachable from the phone).
PUBLIC_BASE_URL=http://localhost:8787
DATABASE_URL=postgres://soup:soup@localhost:5433/soup_identity

# Google OIDC — required for real phone Google SSO.
# Leave CLIENT_ID/SECRET empty to use the ALLOW_DEV_LOGIN HTML/curl approve path.
# Redirect URI must match Google Cloud Console → Credentials → Authorized redirect URIs exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/google/callback

# Dev-only: when Google client is unset, device-link can complete with DEV_GOOGLE_EMAIL
DEV_GOOGLE_EMAIL=dev@example.com
ALLOW_DEV_LOGIN=true

# JWT assertions: RS256 recommended (Jellyfin plugin IdentityModel cannot verify EdDSA)
JWT_ALG=RS256
# Optional PEM overrides; generated and persisted under data/ on first boot if unset
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
ASSERTION_TTL_SECONDS=180
ASSERTION_ISSUER=https://soup.local/identity

# Soup app sessions
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=90

# Bootstrap plugin credential (created on migrate if set)
BOOTSTRAP_PLUGIN_ID=dev-plugin
BOOTSTRAP_PLUGIN_SECRET=dev-plugin-secret-change-me

# AES-256 key for transport-grant material (64 hex chars or base64 of 32 bytes)
# Dev default is baked into the service; set a real key in production.
# TRANSPORT_GRANT_ENCRYPTION_KEY=
